# cp .env.example .env

PLATFORM_API_KEY=pk-...
PLATFORM_API_BASE_URL=https://hackspain.getprosperapp.com
HELMCODE_API_KEY=
HELMCODE_BASE_URL=https://api.helmcode.com/v1
HELMCODE_MODEL=deepseek-v4-flash
SEND_IMMEDIATE_RESPONSES=true

# Used when HELMCODE_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=minimal
# Optional exact provider slug when OPENAI_BASE_URL points to OpenRouter.
OPENROUTER_PROVIDER=

TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest

TTS_PROVIDER=cartesia
TTS_VOICE=de38f545-c574-44e8-9b54-a7d6fec1c6b1
TTS_LANGUAGE=en
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=

# Set to write synchronized audio and event timelines to <dir>/<call_id>/
CALL_RECORDINGS_DIR=outputs/recordings
